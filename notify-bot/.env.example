# Copy to .env and fill in.

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Your Telegram user id (send /id to the bot). Only these ids can read the notifications, and each
# gets them forwarded. Comma-separated for more than one.
OWNERS=

# The secret the phone app sends with every notification: at least 16 characters.
# Make one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEVICE_TOKEN=

# Where the phone reaches the server.
# HOST=0.0.0.0
# PORT=8787

# The database file.
# DB_FILE=./data/notifications.db

# Days to keep notifications; 0 keeps them forever.
# KEEP_DAYS=0

# Time zone for the times the bot shows (default: this computer's).
# TZ_NAME=Asia/Riyadh
