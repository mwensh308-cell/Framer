# Copy to .env (or set in your hosting provider) — never commit real secrets.
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000

# REQUIRED in production: long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me

# SQLite file location (use a persistent volume in production)
DB_FILE=./data/store.db

STORE_CURRENCY=EGP
SHIPPING_FLAT=15000            # minor units (150.00 EGP)
FREE_SHIPPING_THRESHOLD=500000 # minor units (5,000.00 EGP)

# Seeded admin account (created by `npm run seed` / first boot)
ADMIN_EMAIL=admin@el3alamy.store
ADMIN_PASSWORD=ChangeMe!2026

# Card payments via Stripe Checkout. Leave empty to use the dev mock (disabled in production).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
