{"total": 375.94, "open": 4.2, "sections": [{"id": "intro", "title": "المقدمة", "name": "", "role": "", "text": "في الحلقة الأولى عرفنا السالفة، وفي الحلقة الثانية لفّينا ليونيدا من فايس سيتي لين جبل كالاجا. بس أي مدينة ما تسوى شي بدون ناسها. اليوم بنقعد مع الوجيه اللي بيدخلون حياة جايسون ولوسيا، واحد واحد. مين صديق، ومين شريك، ومين ممكن يطعنك من ورا وهو يضحك في وجهك. خلك معي للآخر، لأن في الأخير عندي سؤال لك.", "start": 4.2, "dur": 31.56, "words": [{"w": "في", "t": 0.102083, "d": 0.104166}, {"w": "الحلقة", "t": 0.219291, "d": 0.507833}, {"w": "الأولى", "t": 0.740125, "d": 0.364583}, {"w": "عرفنا", "t": 1.117708, "d": 0.403666}, {"w": "السالفة", "t": 1.534375, "d": 0.742208}, {"w": "وفي", "t": 2.510958, "d": 0.325541}, {"w": "الحلقة", "t": 2.8495, "d": 0.494791}, {"w": "الثانية", "t": 3.357291, "d": 0.598958}, {"w": "لفّينا", "t": 3.969291, "d": 0.520833}, {"w": "ليونيدا", "t": 4.503125, "d": 0.572916}, {"w": "من", "t": 5.089083, "d": 0.14325}, {"w": "فايس", "t": 5.245333, "d": 0.481791}, {"w": "سيتي", "t": 5.740125, "d": 0.325541}, {"w": "لين", "t": 6.078666, "d": 0.208333}, {"w": "جبل", "t": 6.3, "d": 0.325541}, {"w": "كالاجا", "t": 6.638541, "d": 0.755208}, {"w": "بس", "t": 8.307291, "d": 0.416666}, {"w": "أي", "t": 8.737, "d": 0.234375}, {"w": "مدينة", "t": 8.984375, "d": 0.625}, {"w": "ما", "t": 9.622416, "d": 0.14325}, {"w": "تسوى", "t": 9.778666, "d": 0.46875}, {"w": "شي", "t": 10.260416, "d": 0.234375}, {"w": "بدون", "t": 10.507833, "d": 0.416666}, {"w": "ناسها", "t": 10.9375, "d": 0.677083}, {"w": "اليوم", "t": 12.526041, "d": 0.533875}, {"w": "بنقعد", "t": 13.072916, "d": 0.533875}, {"w": "مع", "t": 13.619791, "d": 0.169291}, {"w": "الوجيه", "t": 13.802083, "d": 0.520833}, {"w": "اللي", "t": 14.335958, "d": 0.260416}, {"w": "بيدخلون", "t": 14.609375, "d": 0.677083}, {"w": "حياة", "t": 15.2995, "d": 0.46875}, {"w": "جايسون", "t": 15.78125, "d": 0.46875}, {"w": "ولوسيا", "t": 16.263041, "d": 0.911458}, {"w": "واحد", "t": 17.395833, "d": 0.533875}, {"w": "واح