هامبتون، صديق جايسون في الكيز. كال يحس براحته في زوايا الإنترنت المظلمة أكثر من أي مكان ثاني، ويشوف إن كل شي حوله مؤامرة. يتصنت على اتصالات خفر السواحل، ويحلل كل خبر، ومقتنع إنه أذكى واحد في الغرفة. بس لو تخيّره بين مغامرة كبيرة وقعدة في البيت مع مشروب بارد، اختياره واضح. كال ممكن يكون عقل الفريق، أو أكبر سبب إن الخطة تخرب.", "start": 118.572, "dur": 36.384, "words": [{"w": "كال", "t": 0.102083, "d": 0.208333}, {"w": "هامبتون", "t": 0.323458, "d": 0.651041}, {"w": "صديق", "t": 1.208875, "d": 0.664083}, {"w": "جايسون", "t": 1.885958, "d": 0.494791}, {"w": "في", "t": 2.39375, "d": 0.14325}, {"w": "الكيز", "t": 2.55, "d": 0.807291}, {"w": "كال", "t": 4.257833, "d": 0.182291}, {"w": "يحس", "t": 4.453125, "d": 0.429708}, {"w": "براحته", "t": 4.895833, "d": 0.78125}, {"w": "في", "t": 5.690125, "d": 0.182291}, {"w": "زوايا", "t": 5.885416, "d": 0.442708}, {"w": "الإنترنت", "t": 6.341166, "d": 0.638041}, {"w": "المظلمة", "t": 6.992208, "d": 0.598958}, {"w": "أكثر", "t": 7.604166, "d": 0.416666}, {"w": "من", "t": 8.033875, "d": 0.117208}, {"w": "أي", "t": 8.164083, "d": 0.273458}, {"w": "مكان", "t": 8.450541, "d": 0.45575}, {"w": "ثاني", "t": 8.919291, "d": 0.533875}, {"w": "ويشوف", "t": 9.648458, "d": 0.703125}, {"w": "إن", "t": 10.364583, "d": 0.221375}, {"w": "كل", "t": 10.598958, "d": 0.286458}, {"w": "شي", "t": 10.898458, "d": 0.390625}, {"w": "حوله", "t": 11.302083, "d": 0.520833}, {"w": "مؤامرة", "t": 11.835958, "d": 0.703125}, {"w": "يتصنت", "t": 13.450541, "d": 0.677083}, {"w": "على", "t": 14.140625, "d": 0.195333}, {"w": "اتصالات", "t": 14.348958, "d": 0.729166}, {"w": "خفر", "t": 15.091166, "d": 0.351583}, {"w": "السواحل", "t": 15.45575, "d": 0.846375}, {"w": "ويحلل", "t": 16.5625, "d": 0.729166}, {"w": "كل", "t": 17.304708, "d": 0.286458}, {"w": "خبر", "t": 17.604166, "d": 0.507833}, {"w": "ومقتنع", "t": 18.385416, "d": 0.846375}, {"w": "إنه", "t": 19.244791, "d": 0.416666}, {"w": "أذكى", "t": 19.6745, "d": 0.325541}, {"w": "واحد", "t": 20.013041, "d": 0.546875},