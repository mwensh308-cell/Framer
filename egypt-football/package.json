{
  "name": "egypt-football-archive",
  "version": "0.1.0",
  "private": true,
  "description": "The Pharaohs' Archive — history of Egyptian football: players, clubs, championships, national teams, live news and an admin dashboard.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "dev": "node --no-warnings --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "typecheck": "npm --prefix web run typecheck",
    "seed": "node --no-warnings server/seed.js --reset",
    "test": "node --no-warnings --test test/*.test.js",
    "postinstall": "npm --prefix web install --no-audit --no-fund"
  },
  "dependencies": {
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.5"
  }
}
