# Copy to .env and fill in.

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Telegram user ids allowed to use the bot, comma-separated. Required: the bot runs a coding agent
# on this machine. Send /id to the bot to learn yours.
ALLOWED_USERS=

# The coding agent: claude-code (default), codex, or the name of any other program (run as
# `<program> <message>`, its output read as text).
AGENT=claude-code
# AGENT_PROGRAM=/path/to/claude
# AGENT_ARGS=
# AGENT_MODEL=

# Where projects are kept (one folder per chat).
# DATA_DIR=./data

# Refinement rounds after the first build, and the likeness (percent) that's good enough.
# MAX_ROUNDS=4
# GOOD_ENOUGH=85

# Builds at the same time (the rest wait in order), and one builder turn's time limit.
# MAX_RUNS=2
# TURN_TIMEOUT_MIN=30

# Screenshot widths for studying and checking websites.
# WIDTHS=1280,390
